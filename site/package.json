{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3444",
    "build": "pnpm run --filter=@marsidev/react-turnstile build && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@marsidev/react-turnstile": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1",
    "wrangler": "4.141.0"
  }
}
